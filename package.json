  "bugs": {
    "url": "https://github.com/amin-abbasi/gach/issues"
  },
  "homepage": "https://github.com/amin-abbasi/gach#readme",
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
