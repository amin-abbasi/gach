{
  "name": "gach",
  "version": "1.8.0",
  "description": "Chainable ANSI colours and styles for terminal text, typed, with no dependencies.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
